# ElevenLabs API key (required for TTS)
ELEVENLABS_API_KEY=

# Default voice ID (optional — falls back to Claude voice from voices.json)
ELEVENLABS_VOICE_ID=

# Cache directory for replayed audio (default: ./cache)
SPEAK_CACHE_DIR=

# HTTP port for daemon + dashboard (default: 7865)
SPEAK_PORT=

# --- Streaming engine (all optional) ---
#
# Leave these commented out to get the defaults. An EMPTY value is not the same
# as an absent one: the integer knobs below are parsed with int() at startup, so
# `SPEAK_PREROLL_MS=` crashes the daemon where omitting the line entirely works.

# Kill switch — 0 restores the legacy fetch-whole-file-then-play path (default: 1)
#SPEAK_STREAMING=1

# ElevenLabs model id for single-voice synthesis (default: eleven_v3)
#SPEAK_MODEL=eleven_v3

# Audio decoded before live playback starts, ms — integer (default: 500)
#SPEAK_PREROLL_MS=500

# Rewind applied on resume so a pause replays rather than skips, ms — integer (default: 1000)
#SPEAK_RESUME_REWIND_MS=1000

# Live-mode player: auto | ffplay | audiotoolbox (default: auto, probed at startup)
#SPEAK_LIVE_PLAYER=auto

# Concurrent streaming fetches — integer (default: 8)
#SPEAK_COLLECTOR_WORKERS=8
